# 后端 java 程序所需环境变量列表
# 复制此文件为 .env 并填入真实值：
#   cp infra/docker/backend/.env.example infra/docker/backend/.env
#
# 注意：全栈 compose 中 backend/mysql/redis 在桥接网络内，通过服务名互访

# 更推荐在 application 系列文件中设置环境变量

# ===== Spring =====
SPRING_PROFILES_ACTIVE=dev

# ===== BBS OIDC 客户端 =====
# 先在 Auth 管理接口登记 BBS，使用返回的客户端 ID 和明文密钥。
BBS_PORT=8080
BBS_AUTH_ISSUER=https://nobeta.cn/auth
BBS_AUTH_CLIENT_ID=para-bbs
BBS_AUTH_CLIENT_SECRET=replace_with_registered_client_secret
BBS_OIDC_REDIRECT_URI=https://nobeta.cn/bbs/api/auth/sso/callback/auth
BBS_SECURE_COOKIES=true
# 仅在可信反向代理覆盖转发头且后端限制访问时改为 FRAMEWORK。
BBS_FORWARD_HEADERS_STRATEGY=NONE
# 本地 HTTP 联调应修改 issuer 和已登记的回调地址，并设 BBS_SECURE_COOKIES=false。

# ===== MySQL =====
PARA_DATASOURCE_URL=jdbc:mysql://mysql:3306/para_bbs?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
PARA_DATASOURCE_USERNAME=root
PARA_DATASOURCE_PASSWORD=change_me

# ===== Redis =====
PARA_REDIS_HOST=redis
PARA_REDIS_PORT=6379
PARA_REDIS_PASSWORD=
PARA_REDIS_DATABASE=0
PARA_REDIS_CONNECT_TIMEOUT=3000ms
PARA_REDIS_TIMEOUT=3000ms
PARA_REDIS_LETTUCE_POOL_MAX_ACTIVE=16
PARA_REDIS_LETTUCE_POOL_MAX_IDLE=8
PARA_REDIS_LETTUCE_POOL_MIN_IDLE=4
PARA_REDIS_LETTUCE_POOL_MAX_WAIT=1000ms

# ===== JWT =====
PARA_JWT_SECRET=change_me_to_a_256bit_key_for_hmac_sha256
# 单位为秒：短期访问令牌、最长一周的 BBS 本地登录。
PARA_JWT_ACCESS_TOKEN_EXPIRE=900
PARA_JWT_REFRESH_TOKEN_EXPIRE=604800

# ===== Github =====
PARA_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# ===== 文件存储 =====
PARA_FILE_AVATAR_ROOT_PATH=/data/parabbs/images
PARA_FILE_AVATAR_MAX_SIZE=15728640
PARA_FILE_AVATAR_EXPIRE=2
PARA_FILE_IMAGE_MAX_SIZE=31457280

# ===== RabbitMQ =====
PARA_RABBITMQ_USERNAME=parabbs
PARA_RABBITMQ_PASSWORD=123456

# ===== Elasticsearch =====
PARA_ELASTICSEARCH_URIS=http://elasticsearch:9200
