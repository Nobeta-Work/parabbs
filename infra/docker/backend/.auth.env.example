# Auth 容器环境变量。复制为同目录下的 .auth.env，再填写真实值。
# 此文件由 Compose 的 env_file 读取，不会自动设置宿主机环境变量。
# 数据库由管理员使用 infra/mysql/auth_schema.sql 手动建立，不自动执行 SQL。

# # 服务及对外地址
# 与 Compose 的 9000:9000 端口映射保持一致。
AUTH_PORT=9000
# ! 必须是浏览器和客户端实际访问的认证中心地址，包含 /auth。
# 容器内部运行 HTTP；生产环境由反向代理提供 HTTPS。
AUTH_ISSUER=https://nobeta.cn/auth
AUTH_ALLOW_LOCAL_HTTP=false
AUTH_SECURE_COOKIES=true
# 仅当可信代理清除并重写转发头时改为 FRAMEWORK 或 NATIVE。
AUTH_FORWARD_HEADERS_STRATEGY=NONE
# 本地直接使用 HTTP 时，改为 http://localhost:9000/auth，
# 同时设置 AUTH_ALLOW_LOCAL_HTTP=true、AUTH_SECURE_COOKIES=false。

# # MySQL
# 此后端 Compose 不包含中间件：默认连接宿主机开放的 MySQL/Redis 端口。
# host.docker.internal 由 Compose 的 extra_hosts 映射到宿主机网关。
# 若使用其他服务器或共享 Docker 网络，请修改数据库地址及 Redis 主机。
# ! 需提前创建 para_auth 数据库、导入表结构，并允许该账号从容器连接。
AUTH_DB_URL=jdbc:mysql://host.docker.internal:3306/para_auth?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
AUTH_DB_USERNAME=para_auth
AUTH_DB_PASSWORD=replace_with_database_password

# # Redis：保存 Auth 用户会话
AUTH_REDIS_HOST=host.docker.internal
AUTH_REDIS_PORT=6379
# 未使用 ACL 用户或密码认证时，可以保留空值；否则与实际 Redis 配置一致。
AUTH_REDIS_USERNAME=
AUTH_REDIS_PASSWORD=
AUTH_REDIS_DATABASE=0

# # JWT 签名密钥
# Compose 将 backend/auth/.local/auth-signing.p12 只读挂载到此容器路径。
# ! 这里必须使用容器路径，不能使用 Windows 本机路径。
AUTH_KEYSTORE_LOCATION=file:/run/secrets/auth-signing.p12
# 从 backend/auth/.local/auth-keys.env 取对应密码，仅填写到本地 .auth.env。
AUTH_KEYSTORE_PASSWORD=replace_with_keystore_password
# 当前生成的文件使用相同的密钥库密码及私钥密码。
AUTH_KEY_PASSWORD=replace_with_keystore_password
AUTH_SIGNING_KEY_ALIAS=auth-signing

# # 账号注册与管理员初始化
# 此开关控制用户账号注册，不是 OIDC 动态客户端注册。
AUTH_REGISTRATION_ENABLED=true
# 首次创建管理员时设为 true，并填写账号、密码；初始化后设回 false。
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
