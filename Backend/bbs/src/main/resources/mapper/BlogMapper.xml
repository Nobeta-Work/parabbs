<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.nobeta.bbs.module.blog.mapper.BlogMapper">

    <sql id="BlogColumns">
        id,
        title,
        content,
        summary,
        cover_url,
        author_id,
        folder_id,
        is_published,
        like_count,
        comments_count,
        create_time,
        update_time
    </sql>

    

    <!-- insertBlog --> 

    <insert id="insertBlog" parameterType="cn.nobeta.bbs.module.blog.entity.Blog">
        INSERT INTO blog (
            id,
            author_id,
            folder_id,
            is_published,
            title,
            summary,
            cover_url,
            content
        ) VALUES (
            #{id},
            #{authorId},
            #{folderId},
            #{isPublished},
            #{title},
            '',
            #{coverUrl},
            ''
        )
    </insert>

    <!-- selectBlogPage --> 

    <select id="selectBlogPage"
            resultType="cn.nobeta.bbs.module.blog.entity.Blog">
        SELECT
            <include refid="BlogColumns"></include>
        FROM blog
        WHERE is_published = 1
            <if test="keyword != null and keyword != ''">
                AND (
                    title LIKE CONCAT('%', #{keyword}, '%')
                    OR summary LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <if test="authorId != null">
                AND author_id = #{authorId}
            </if>
            <if test="tagIds != null and tagIds.size() > 0">
                <bind name="tagCount" value="tagIds.size()" />
                AND id IN (
                    SELECT bt.blog_id
                    FROM blog_tag bt
                    WHERE bt.tag_id IN
                        <foreach collection="tagIds" item="tagId" open="(" separator="," close=")">
                            #{tagId}
                        </foreach>
                    GROUP BY bt.blog_id
                    HAVING COUNT(DISTINCT bt.tag_id) = #{tagCount}
                )
            </if>
        ORDER BY
            <choose>
                <when test="sortField == 'updateTime'">
                    update_time
                </when>
                <when test="sortField == 'likeCount'">
                    like_count
                </when>
                <otherwise>
                    create_time
                </otherwise>
            </choose>

            <choose>
                <when test="sortOrder != null and sortOrder.toLowerCase() == 'asc'">
                    ASC
                </when>
                <otherwise>
                    DESC
                </otherwise>
            </choose>
    </select>


    <!-- selectBlogById --> 

    <select id="selectBlogById" parameterType="long"
            resultType="cn.nobeta.bbs.module.blog.entity.Blog">
        SELECT
            <include refid="BlogColumns"></include>
        FROM blog
        WHERE id = #{id}
    </select>

    <!-- updateBlogById --> 

    <update id="updateBlogById">
        UPDATE blog
        SET 
            <if test="dto.folderId != null">
                folder_id = #{dto.folderId},
            </if>
            <if test="dto.isPublished != null">
                is_published = #{dto.isPublished},
            </if>
            title = #{dto.title},
            summary = #{dto.summary},
            cover_url = #{dto.coverUrl},
            content = #{dto.content}
        WHERE id = #{blogId}
    </update>

    <!-- deleteBlogById --> 

    <delete id="deleteBlogById">
        DELETE FROM blog
        WHERE id = #{blogId}
    </delete>

    <update id="incrementCommentsCount">
        UPDATE blog
        SET comments_count = comments_count + 1
        WHERE id = #{blogId}
    </update>

    <update id="decrementCommentsCount">
        UPDATE blog
        SET comments_count = GREATEST(comments_count - 1, 0)
        WHERE id = #{blogId}
    </update>

    <!-- batchResetBlogFolderByAuthorIdAndFolderIds --> 

    <update id="batchResetBlogFolderByAuthorIdAndFolderIds">
        UPDATE blog
        SET
            folder_id = 0
        WHERE author_id = #{userId}
            AND folder_id IN
                <foreach collection="folderIds" item="folderId" open="(" separator="," close=")">
                    #{folderId}
                </foreach>
    </update>

    <!-- selectBlogPageByFolderId --> 

    <select id="selectBlogPageByFolderId"
            resultType="cn.nobeta.bbs.module.blog.entity.Blog">
        SELECT
            <include refid="BlogColumns"></include>
        FROM blog
        WHERE folder_id = #{folderId} AND author_id = #{authorId}
        ORDER BY
            <choose>
                <when test="query.sortField == 'updateTime'">
                    update_time
                </when>
                <otherwise>
                    create_time
                </otherwise>
            </choose>

            <choose>
                <when test="query.sortOrder != null and query.sortOrder.toLowerCase() == 'asc'">
                    ASC
                </when>
                <otherwise>
                    DESC
                </otherwise>
            </choose>
    </select>

    <!-- updateBlogFolderByAuthorIdAndIds --> 

    <update id="updateBlogFolderByAuthorIdAndIds">
        UPDATE blog
        SET
            folder_id = #{targetId}
        WHERE author_id = #{userId}
            AND id IN
            <foreach collection="blogIds" item="blogId" open="(" separator="," close=")">
                #{blogId}
            </foreach>
    </update>

    <!-- selectSearchDocumentById --> 

    <resultMap id="BlogSearchDocumentMap"
               type="cn.nobeta.bbs.module.blog.entity.BlogSearchDocument">
        <id property="id" column="id" />
        <result property="authorId" column="author_id" />
        <result property="authorNickname" column="author_nickname" />
        <result property="title" column="title" />
        <result property="summary" column="summary" />
        <result property="coverUrl" column="cover_url" />
        <result property="content" column="content" />
        <result property="likeCount" column="like_count" />
        <result property="commentsCount" column="comments_count" />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
        <collection property="tagIds" ofType="java.lang.Long">
            <result column="tag_id" />
        </collection>
        <collection property="tagNames" ofType="java.lang.String">
            <result column="tag_name" />
        </collection>
    </resultMap>

    <select id="selectSearchDocumentById"
            resultMap="BlogSearchDocumentMap">
        SELECT
            b.id,
            b.author_id,
            u.nickname AS author_nickname,
            b.title,
            b.summary,
            b.cover_url,
            b.content,
            b.like_count,
            b.comments_count,
            b.create_time,
            b.update_time,
            bt.tag_id,
            t.name AS tag_name
        FROM blog b
        JOIN user_profile u ON u.user_id = b.author_id
        LEFT JOIN blog_tag bt ON bt.blog_id = b.id
        LEFT JOIN tag t ON t.id = bt.tag_id
        WHERE b.id = #{blogId}
            AND b.is_published = 1
    </select>

    <select id="selectPublishedBlogIds" resultType="long">
        SELECT id
        FROM blog
        WHERE is_published = 1
        ORDER BY id ASC
    </select>

    <select id="selectPublishedBlogIdsByAuthor" resultType="long">
        SELECT id FROM blog WHERE author_id = #{authorId} AND is_published = 1 ORDER BY id
    </select>

    <update id="reconcileCommentsCount">
        UPDATE blog b
        LEFT JOIN (
            SELECT blog_id, COUNT(*) AS comments_count
            FROM `comment`
            WHERE status = 1
            GROUP BY blog_id
        ) c ON c.blog_id = b.id
        SET b.comments_count = COALESCE(c.comments_count, 0)
        WHERE b.comments_count != COALESCE(c.comments_count, 0)
    </update>
</mapper>
