<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.nobeta.bbs.module.admin.mapper.AdminMapper">

    <sql id="RoleColumns">
        id,
        role_code,
        role_name,
        description,
        create_time,
        update_time
    </sql>

    <sql id="PermColumns">
        id,
        perm_code,
        perm_name,
        description,
        create_time
    </sql>

    <sql id="UserColumns">
        u.id, u.username, p.nickname, p.avatar_url, u.status, u.create_time, u.update_time
    </sql>

    <sql id="TagColumns">
        id,
        name,
        description,
        create_time,
        update_time
    </sql>

    <!-- ==================== 角色 ==================== -->

    <!-- selectRolePage -->
    <select id="selectRolePage" parameterType="cn.nobeta.bbs.module.admin.dto.RolePageQuery"
            resultType="cn.nobeta.bbs.module.admin.entity.SysRole">
        SELECT
            <include refid="RoleColumns"></include>
        FROM sys_role
        <if test="keyword != null and keyword != ''">
            WHERE (
                role_code LIKE CONCAT('%', #{keyword}, '%')
                OR role_name LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
        ORDER BY
            <choose>
                <when test="sortField == 'updateTime'">
                    update_time
                </when>
                <otherwise>
                    create_time
                </otherwise>
            </choose>
            <choose>
                <when test="sortOrder != null and sortOrder.toLowerCase() == 'asc'">
                    ASC
                </when>
                <otherwise>
                    DESC
                </otherwise>
            </choose>
    </select>

    <!-- selectRoleById -->
    <select id="selectRoleById" resultType="cn.nobeta.bbs.module.admin.entity.SysRole">
        SELECT
            <include refid="RoleColumns"></include>
        FROM sys_role
        WHERE id = #{roleId}
        LIMIT 1
    </select>

    <!-- selectRoleByCode -->
    <select id="selectRoleByCode" resultType="cn.nobeta.bbs.module.admin.entity.SysRole">
        SELECT
            <include refid="RoleColumns"></include>
        FROM sys_role
        WHERE role_code = #{roleCode}
        LIMIT 1
    </select>

    <!-- selectRoleByName -->
    <select id="selectRoleByName" resultType="cn.nobeta.bbs.module.admin.entity.SysRole">
        SELECT
            <include refid="RoleColumns"></include>
        FROM sys_role
        WHERE role_name = #{roleName}
        LIMIT 1
    </select>

    <!-- insertRole -->
    <insert id="insertRole">
        INSERT INTO sys_role (
            id, role_code, role_name, description
        ) VALUES (
            #{id}, #{roleCode}, #{roleName}, #{description}
        )
    </insert>

    <!-- updateRole -->
    <update id="updateRole">
        UPDATE sys_role
        SET
            role_code = #{roleCode},
            role_name = #{roleName},
            description = #{description}
        WHERE id = #{id}
    </update>

    <!-- selectRolePermBriefByRoleIds -->
    <select id="selectRolePermBriefByRoleIds"
            resultType="cn.nobeta.bbs.module.admin.dto.RolePermBrief">
        SELECT
            rp.role_id,
            p.id AS perm_id,
            p.perm_code,
            p.perm_name
        FROM sys_role_perm rp
        INNER JOIN sys_perm p ON p.id = rp.perm_id
        WHERE rp.role_id IN
            <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
                #{roleId}
            </foreach>
    </select>

    <!-- deleteRolePermsByRoleId -->
    <delete id="deleteRolePermsByRoleId">
        DELETE FROM sys_role_perm
        WHERE role_id = #{roleId}
    </delete>

    <!-- batchInsertRolePerms -->
    <insert id="batchInsertRolePerms">
        INSERT INTO sys_role_perm (
            role_id, perm_id
        ) VALUES
            <foreach collection="permIds" item="permId" separator=",">
                (#{roleId}, #{permId})
            </foreach>
    </insert>

    <!-- ==================== 权限 ==================== -->

    <!-- selectPermPage -->
    <select id="selectPermPage" parameterType="cn.nobeta.bbs.module.admin.dto.PermPageQuery"
            resultType="cn.nobeta.bbs.module.admin.entity.SysPerm">
        SELECT
            <include refid="PermColumns"></include>
        FROM sys_perm
        <if test="keyword != null and keyword != ''">
            WHERE (
                perm_code LIKE CONCAT('%', #{keyword}, '%')
                OR perm_name LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
        ORDER BY create_time DESC
    </select>

    <!-- selectPermById -->
    <select id="selectPermById" resultType="cn.nobeta.bbs.module.admin.entity.SysPerm">
        SELECT
            <include refid="PermColumns"></include>
        FROM sys_perm
        WHERE id = #{permId}
        LIMIT 1
    </select>

    <!-- insertPerm -->
    <insert id="insertPerm">
        INSERT INTO sys_perm (
            id, perm_code, perm_name, description
        ) VALUES (
            #{id}, #{permCode}, #{permName}, #{description}
        )
    </insert>

    <!-- updatePerm -->
    <update id="updatePerm">
        UPDATE sys_perm
        SET
            perm_code = #{permCode},
            perm_name = #{permName},
            description = #{description}
        WHERE id = #{id}
    </update>

    <!-- ==================== 用户 ==================== -->

    <!-- selectAdminUserPage -->
    <select id="selectAdminUserPage" parameterType="cn.nobeta.bbs.module.admin.dto.AdminUserPageQuery"
            resultType="cn.nobeta.bbs.module.admin.vo.AdminUserVO">
        SELECT
            <include refid="UserColumns"></include>
        FROM sys_user u JOIN user_profile p ON p.user_id = u.id
        <where>
            <if test="keyword != null and keyword != ''">
                AND (
                    u.username LIKE CONCAT('%', #{keyword}, '%')
                    OR p.nickname LIKE CONCAT('%', #{keyword}, '%')
                )
            </if>
            <if test="status != null">
                AND u.status = #{status}
            </if>
        </where>
        ORDER BY
            <choose>
                <when test="sortField == 'updateTime'">
                    u.update_time
                </when>
                <otherwise>
                    u.create_time
                </otherwise>
            </choose>
            <choose>
                <when test="sortOrder != null and sortOrder.toLowerCase() == 'asc'">
                    ASC
                </when>
                <otherwise>
                    DESC
                </otherwise>
            </choose>
    </select>

    <!-- selectUserById -->
    <select id="selectUserById" resultType="cn.nobeta.bbs.module.user.entity.User">
        SELECT id, username, status, create_time, update_time FROM sys_user WHERE id = #{userId}
    </select>

    <!-- selectUserRoleBriefByUserIds -->
    <select id="selectUserRoleBriefByUserIds"
            resultType="cn.nobeta.bbs.module.admin.dto.UserRoleBrief">
        SELECT
            ur.user_id,
            r.role_code
        FROM sys_user_role ur
        INNER JOIN sys_role r ON r.id = ur.role_id
        WHERE ur.user_id IN
            <foreach collection="userIds" item="userId" open="(" separator="," close=")">
                #{userId}
            </foreach>
    </select>

    <!-- updateUserStatus -->
    <update id="updateUserStatus">
        UPDATE sys_user
        SET status = #{status}
        WHERE id = #{userId}
    </update>

    <!-- deleteUserRolesByUserId -->
    <delete id="deleteUserRolesByUserId">
        DELETE FROM sys_user_role
        WHERE user_id = #{userId}
    </delete>

    <!-- batchInsertUserRoles -->
    <insert id="batchInsertUserRoles">
        INSERT INTO sys_user_role (
            user_id, role_id
        ) VALUES
            <foreach collection="roleIds" item="roleId" separator=",">
                (#{userId}, #{roleId})
            </foreach>
    </insert>

    <!-- ==================== 博客 ==================== -->

    <!-- selectAdminBlogPage -->
    <select id="selectAdminBlogPage" parameterType="cn.nobeta.bbs.module.admin.dto.AdminBlogPageQuery"
            resultType="cn.nobeta.bbs.module.admin.vo.AdminBlogVO">
        SELECT
            b.id,
            b.title,
            b.summary,
            b.cover_url,
            b.author_id,
            p.nickname AS author_name,
            b.is_published,
            b.like_count,
            b.create_time,
            b.update_time
        FROM blog b
        LEFT JOIN user_profile p ON p.user_id = b.author_id
        <where>
            <if test="keyword != null and keyword != ''">
                AND b.title LIKE CONCAT('%', #{keyword}, '%')
            </if>
            <if test="authorId != null">
                AND b.author_id = #{authorId}
            </if>
            <if test="isPublished != null">
                AND b.is_published = #{isPublished}
            </if>
        </where>
        ORDER BY
            <choose>
                <when test="sortField == 'updateTime'">
                    b.update_time
                </when>
                <when test="sortField == 'likeCount'">
                    b.like_count
                </when>
                <otherwise>
                    b.create_time
                </otherwise>
            </choose>
            <choose>
                <when test="sortOrder != null and sortOrder.toLowerCase() == 'asc'">
                    ASC
                </when>
                <otherwise>
                    DESC
                </otherwise>
            </choose>
    </select>

    <!-- selectBlogById -->
    <select id="selectBlogById" resultType="cn.nobeta.bbs.module.blog.entity.Blog">
        SELECT
            id,
            title,
            content,
            summary,
            cover_url,
            author_id,
            folder_id,
            is_published,
            like_count,
            comments_count,
            create_time,
            update_time
        FROM blog
        WHERE id = #{blogId}
        LIMIT 1
    </select>

    <!-- updateBlogStatus -->
    <update id="updateBlogStatus">
        UPDATE blog
        SET is_published = #{isPublished}
        WHERE id = #{blogId}
    </update>

    <!-- deleteBlogById -->
    <delete id="deleteBlogById">
        DELETE FROM blog
        WHERE id = #{blogId}
    </delete>

    <!-- deleteBlogTagsByBlogId -->
    <delete id="deleteBlogTagsByBlogId">
        DELETE FROM blog_tag
        WHERE blog_id = #{blogId}
    </delete>

    <!-- ==================== 标签 ==================== -->

    <!-- selectAdminTagPage -->
    <select id="selectAdminTagPage" parameterType="cn.nobeta.bbs.module.admin.dto.AdminTagPageQuery"
            resultType="cn.nobeta.bbs.module.admin.vo.AdminTagVO">
        SELECT
            <include refid="TagColumns"></include>
        FROM tag
        <if test="keyword != null and keyword != ''">
            WHERE (
                name LIKE CONCAT('%', #{keyword}, '%')
                OR description LIKE CONCAT('%', #{keyword}, '%')
            )
        </if>
        ORDER BY
            <choose>
                <when test="sortField == 'updateTime'">
                    update_time
                </when>
                <otherwise>
                    create_time
                </otherwise>
            </choose>
            <choose>
                <when test="sortOrder != null and sortOrder.toLowerCase() == 'asc'">
                    ASC
                </when>
                <otherwise>
                    DESC
                </otherwise>
            </choose>
    </select>

    <!-- selectTagById -->
    <select id="selectTagById" resultType="cn.nobeta.bbs.module.tag.entity.Tag">
        SELECT
            <include refid="TagColumns"></include>
        FROM tag
        WHERE id = #{tagId}
        LIMIT 1
    </select>

    <!-- insertAdminTag -->
    <insert id="insertAdminTag">
        INSERT INTO tag (
            id, name, description
        ) VALUES (
            #{id}, #{name}, #{description}
        )
    </insert>

    <!-- updateAdminTag -->
    <update id="updateAdminTag">
        UPDATE tag
        SET
            name = #{name},
            description = #{description}
        WHERE id = #{id}
    </update>

</mapper>
